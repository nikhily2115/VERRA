# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
MONGODB_URI=mongodb+srv://admin_verra:verra@111@cluster0.1qmwpyp.mongodb.net/?appName=Cluster0
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/verra

# Test Database Configuration (optional - defaults to MONGODB_URI with -test suffix)
TEST_MONGODB_URI=mongodb://localhost:27017/verra-test

# JWT Configuration
# IMPORTANT: Use a strong, random secret key (minimum 32 characters)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRE=7d

# Razorpay Configuration
# For testing: Use test keys (rzp_test_xxxxx)
# For production: Use live keys (rzp_live_xxxxx)
# NEVER commit actual keys to version control
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret-key

# CORS Configuration (comma-separated for multiple origins)
CLIENT_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email Configuration (for contact form)
# For Gmail: Use your Gmail address and App Password
# For other providers: Configure SMTP settings in emailService.js
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Logging
LOG_LEVEL=info
